# ==============================================================================
# Command Code Proxy — 部署配置模板
# 复制此文件为 deploy.env 并填入你的服务器信息:
#   cp deploy.env.example deploy.env
#   vim deploy.env
# deploy.env 已在 .gitignore 中，不会被提交
# ==============================================================================
# 本地/服务器 Key 隔离说明:
#   本地  → config.json + keys.json，可无 key 启动（请求头透传）
#   服务器→ config.server.json + keys.server.json，启动 key 必须走环境变量 CC_SERVER_KEY
# 构建时本地 key 不会进入镜像；部署时自动注入服务器 key 并强制校验。
# ==============================================================================

# ---------- 必填: 服务器连接 ----------
SERVER_HOST=1.2.3.4
SERVER_USER=root
SERVER_SSH_PORT=22
# SERVER_SSH_KEY=~/.ssh/id_rsa          # 可选，不填则用默认 ssh key / 密码

# ---------- 必填: 服务器部署 Key 隔离 ----------
# 服务器启动 key，必须以 user_ 开头；仅通过环境变量注入，不落镜像/不写配置
# 获取方式: 本地登录 Command Code 后，复制 Authorization: Bearer user_xxx
CC_SERVER_KEY=user_xxxxxxxxxxxxxxxxxxxxx
# 可选: 服务器多 Key 轮换池文件（本地 keys.server.json），留空则仅使用 CC_SERVER_KEY 单 key
# 如需多 Key 轮换，先本地准备 keys.server.json 再部署: cp keys.json keys.server.json && 按需编辑
# CC_SERVER_KEYS_FILE=keys.server.json

# ---------- 镜像配置 ----------
IMAGE_NAME=commandcode-proxy
IMAGE_TAG=latest
# PLATFORM=linux/amd64                  # 服务器架构: linux/amd64 | linux/arm64 | linux/amd64,linux/arm64(需仓库)

# ---------- 容器配置 ----------
CONTAINER_NAME=cc-proxy
CONTAINER_PORT=3050                      # 容器内端口（与 proxy.mjs 一致）
HOST_PORT=3050                           # 服务器对外端口

# ---------- 传输模式 ----------
# direct  = 本地 docker save | ssh docker load 直传，无需镜像仓库（默认，适合个人服务器）
# registry= 推送到镜像仓库，服务器 docker pull（适合多架构/团队/CI）
TRANSFER_MODE=direct
# REGISTRY=ghcr.io/yourname              # registry 模式时必填，如 ghcr.io/yourname 或 docker.io/yourname

# ---------- 远程启动模式 ----------
# run     = docker run 直接启动（默认，简单）
# compose = docker compose 启动（需要远程有 docker-compose.yml + config.server.json）
# REMOTE_MODE=run

# REMOTE_DIR=~/commandcode-proxy         # compose 模式时的远程目录
